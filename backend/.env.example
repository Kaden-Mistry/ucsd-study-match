# Copy this file to ".env" (no ".example") and fill in your real values.
# The real ".env" file is listed in .gitignore, so it never gets committed
# or pushed to GitHub.

# The Firebase project ID backing Google Sign-In (Firebase console -> Project
# settings -> General -> "Project ID"). Not a secret — it must just match the
# projectId in frontend/index.html's firebaseConfig, since it's used as the
# expected audience when verifying ID tokens.
FIREBASE_PROJECT_ID=your-firebase-project-id
