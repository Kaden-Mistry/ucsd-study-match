# Copy this file to ".env" (no ".example") and fill in your real values.
# The real ".env" file is listed in .gitignore, so it never gets committed
# or pushed to GitHub.

# The Firebase project ID backing Google Sign-In (Firebase console -> Project
# settings -> General -> "Project ID"). Not a secret — it must just match the
# projectId in frontend/index.html's firebaseConfig, since it's used as the
# expected audience when verifying ID tokens.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Protects the one-time POST /api/admin/reset-data cleanup endpoint (wipes
# all postings and messages, e.g. to clear out test data before real users
# show up). Callers must send it back as the X-Admin-Secret header. Set this
# to an actual secret, not the default below — and once the cleanup endpoint
# is no longer needed, remove it from app.py entirely rather than relying on
# this secret alone.
ADMIN_SECRET=changeme

# Resend API key (resend.com) for the "new message" email notification. If
# unset, notifications are silently skipped — message sending never fails
# because of this.
RESEND_API_KEY=your-resend-api-key

# Where the SQLite database file lives. Leave unset for local dev (falls
# back to backend/study_match.db). On Railway, set this to a path on a
# mounted persistent volume (e.g. /data/study_match.db) — Railway's default
# filesystem is ephemeral, so without a volume + this variable, every
# redeploy silently wipes the database.
DATABASE_PATH=/data/study_match.db
